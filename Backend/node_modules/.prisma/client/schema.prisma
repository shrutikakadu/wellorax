// This is your Prisma schema file
// Learn more about it at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USER ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthProfile HealthProfile?
  orders        Order[]
  nutritionLogs NutritionLog[]
  mealPlans     MealPlan[]
  groceryOrders GroceryOrder[]
  appointments  Appointment[]
  chatMessages  ChatMessage[]
  addresses     Address[]
}

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  DOCTOR
  DELIVERY_AGENT
  ADMIN
}

model HealthProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                Int
  heightCm           Float
  weightKg           Float
  targetWeightKg     Float
  fitnessGoal        String // "PCOS Relief", "Diabetes Control", etc.
  dailyCalorieTarget Int
  diseases           String // JSON string array e.g. '["PCOS","Hypertension"]'
  activityLevel      String   @default("Moderate")
  dietaryPreference  String   @default("Vegetarian")
  bmi                Float?
  updatedAt          DateTime @updatedAt
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Home", "Work", "Other"
  line1     String
  line2     String?
  city      String
  pincode   String
  isDefault Boolean @default(false)
}

// ─── RESTAURANTS & MEALS ──────────────────────────────────────────────────────

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  description String?
  cuisine     String
  imageUrl    String?
  rating      Float    @default(4.5)
  totalOrders Int      @default(0)
  isActive    Boolean  @default(true)
  openTime    String   @default("09:00")
  closeTime   String   @default("22:00")
  deliveryMin Int      @default(25) // min delivery time
  deliveryMax Int      @default(40)
  deliveryFee Float    @default(0)
  minOrder    Float    @default(0)
  tags        String // JSON array: '["Keto","Vegan","PCOS-Friendly"]'
  city        String   @default("Mumbai")
  createdAt   DateTime @default(now())

  meals  Meal[]
  orders Order[]
}

model Meal {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String
  imageUrl     String?
  price        Float
  category     String // "Breakfast", "Lunch", "Dinner", "Snack", "Drink"
  tags         String // JSON: '["Keto","Low-GI","PCOS-Friendly"]'
  isVeg        Boolean    @default(true)
  isAvailable  Boolean    @default(true)

  // Nutrition per serving
  calories Int
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float
  sugar    Float
  sodium   Float

  // Health Scores
  glycemicIndex Int?
  healthScore   Float   @default(8.0)
  aiHealthTag   String? // e.g. "Best for PCOS", "Diabetic Safe"

  orderItems    OrderItem[]
  nutritionLogs NutritionLog[]
  mealSlots     MealSlot[]

  createdAt DateTime @default(now())
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  status       OrderStatus @default(PLACED)
  totalAmount  Float
  deliveryFee  Float       @default(0)
  discount     Float       @default(0)
  instructions String?
  addressId    String?

  items    OrderItem[]
  tracking OrderTracking[]

  placedAt    DateTime  @default(now())
  deliveredAt DateTime?
  updatedAt   DateTime  @updatedAt
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mealId   String
  meal     Meal   @relation(fields: [mealId], references: [id])
  quantity Int
  price    Float // price at time of order
}

model OrderTracking {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  message   String
  timestamp DateTime @default(now())
}

// ─── NUTRITION ────────────────────────────────────────────────────────────────

model NutritionLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  mealId   String?
  meal     Meal?    @relation(fields: [mealId], references: [id])
  mealName String // fallback if custom entry
  mealType String // "Breakfast", "Lunch", "Dinner", "Snack"
  calories Int
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float
  loggedAt DateTime @default(now())
}

// ─── MEAL PLANS ───────────────────────────────────────────────────────────────

model MealPlan {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  weekStart     DateTime
  isAiGenerated Boolean  @default(true)
  createdAt     DateTime @default(now())

  slots MealSlot[]
}

model MealSlot {
  id         String   @id @default(cuid())
  planId     String
  plan       MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  mealId     String?
  meal       Meal?    @relation(fields: [mealId], references: [id])
  dayOfWeek  Int // 0=Mon, 6=Sun
  mealType   String // "Breakfast", "Lunch", "Dinner", "Snack"
  customName String? // if not from DB
}

// ─── GROCERY ──────────────────────────────────────────────────────────────────

model GroceryProduct {
  id          String  @id @default(cuid())
  name        String
  brand       String?
  category    String // "Vegetables", "Fruits", "Dairy", "Grains", "Proteins"
  imageUrl    String?
  price       Float
  unit        String // "kg", "g", "L", "ml", "pack"
  stock       Int     @default(100)
  isOrganic   Boolean @default(false)
  isAvailable Boolean @default(true)

  // Nutrition per 100g
  calories Int?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?

  healthTag String? // "Diabetic Safe", "PCOS Friendly", "Keto"

  groceryItems GroceryItem[]
}

model GroceryOrder {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  status      GroceryOrderStatus @default(PLACED)
  totalAmount Float
  items       GroceryItem[]
  placedAt    DateTime           @default(now())
}

enum GroceryOrderStatus {
  PLACED
  PICKING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model GroceryItem {
  id        String         @id @default(cuid())
  orderId   String
  order     GroceryOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   GroceryProduct @relation(fields: [productId], references: [id])
  quantity  Float
  price     Float
}

// ─── DOCTORS ──────────────────────────────────────────────────────────────────

model Doctor {
  id            String  @id @default(cuid())
  name          String
  specialty     String // "Nutritionist", "Endocrinologist", "General Physician"
  qualification String
  experience    Int // years
  rating        Float   @default(4.8)
  imageUrl      String?
  fee           Float
  bio           String?
  isAvailable   Boolean @default(true)
  languages     String // JSON: '["English","Hindi"]'

  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  status      AppointmentStatus @default(SCHEDULED)
  type        String // "Video", "Chat", "In-Person"
  scheduledAt DateTime
  notes       String?
  createdAt   DateTime          @default(now())
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

// ─── AI ASSISTANT ─────────────────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}
